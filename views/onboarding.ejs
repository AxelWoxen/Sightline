<%- include('partials/header') %>
<main class="page narrow">
  <section class="card">
    <p class="eyebrow">Step 1</p>
    <h1>Build your photo profile</h1>
    <p class="muted">Denne informasjonen brukes senere for å gjøre challenges og feedback mer personlig.</p>

    <form class="form" action="/onboarding" method="POST">
      <label>Name
        <input name="name" placeholder="Axel" required />
      </label>

      <label>Email
        <input type="email" name="email" placeholder="you@example.com" />
      </label>

      <label>Experience level
        <select name="experience_level" required>
          <option value="Beginner">Beginner</option>
          <option value="Intermediate">Intermediate</option>
          <option value="Advanced">Advanced</option>
        </select>
      </label>

      <label>Preferred style
        <select name="preferred_style" required>
          <option value="Street photography">Street photography</option>
          <option value="Travel photography">Travel photography</option>
          <option value="Cinematic photography">Cinematic photography</option>
          <option value="Portraits">Portraits</option>
          <option value="Documentary">Documentary</option>
        </select>
      </label>

      <label>Camera / phone
        <input name="camera" placeholder="iPhone, Fujifilm, Sony, Canon..." />
      </label>

      <label>Your goal
        <textarea name="goal" rows="4" placeholder="I want to take better travel and street photos..."></textarea>
      </label>

      <button class="button primary" type="submit">Create profile</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
