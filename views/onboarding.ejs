<%- include('partials/header') %>
<main class="page narrow">

  <div class="ob-progress">
    <div class="ob-dot active" data-step="1"></div>
    <div class="ob-line"></div>
    <div class="ob-dot" data-step="2"></div>
    <div class="ob-line"></div>
    <div class="ob-dot" data-step="3"></div>
  </div>

  <form id="ob-form" action="/onboarding" method="POST">

    <!-- Steg 1: Hvem er du -->
    <section class="card ob-step" id="ob-step-1">
      <p class="eyebrow">Steg 1 av 3</p>
      <h1>Hvem er du?</h1>
      <p class="muted">Sightline bruker dette for å gi deg personlig tilbakemelding.</p>

      <div class="form">
        <label>Navn
          <input name="name" placeholder="Axel" required />
        </label>

        <label>Kamera eller telefon
          <input name="camera" placeholder="iPhone 15, Canon EOS R50, Sony A6400..." />
        </label>

        <label>Erfaring</label>
        <div class="ob-choice-group">
          <label class="ob-choice">
            <input type="radio" name="experience_level" value="Helt ny" />
            <span>
              <strong>Helt ny</strong>
              <small>Har nettopp startet, eller tar frem kameraet av og til</small>
            </span>
          </label>
          <label class="ob-choice">
            <input type="radio" name="experience_level" value="Har prøvd litt" />
            <span>
              <strong>Har prøvd litt</strong>
              <small>Har tatt noen bilder, kjenner til noen innstillinger</small>
            </span>
          </label>
          <label class="ob-choice">
            <input type="radio" name="experience_level" value="Kan litt men vil bli bedre" />
            <span>
              <strong>Kan litt men vil bli bedre</strong>
              <small>Komfortabel med kameraet, men bildene er sjelden slik jeg vil ha dem</small>
            </span>
          </label>
        </div>

        <button type="button" class="button primary" id="ob-next-1">Neste →</button>
      </div>
    </section>

    <!-- Steg 2: Hva vil du fotografere -->
    <section class="card ob-step ob-hidden" id="ob-step-2">
      <p class="eyebrow">Steg 2 av 3</p>
      <h1>Hva vil du fotografere?</h1>
      <p class="muted">Velg den stilen som passer best. Du kan alltid prøve den andre også.</p>

      <div class="ob-style-group">
        <label class="ob-style-card">
          <input type="radio" name="preferred_style" value="Landskap" />
          <div class="ob-style-inner">
            <div class="ob-style-icon">🏔</div>
            <strong>Landskap</strong>
            <small>Parker, hav, himmel, natur. Bilder der lyset og stemningen er hovedrollen.</small>
          </div>
        </label>
        <label class="ob-style-card">
          <input type="radio" name="preferred_style" value="Street" />
          <div class="ob-style-inner">
            <div class="ob-style-icon">🏙</div>
            <strong>Street</strong>
            <small>Byliv, folk, arkitektur. Bilder som fanger et øyeblikk i verden rundt deg.</small>
          </div>
        </label>
      </div>

      <div class="ob-nav-row">
        <button type="button" class="button secondary" id="ob-back-2">← Tilbake</button>
        <button type="button" class="button primary" id="ob-next-2">Neste →</button>
      </div>
    </section>

    <!-- Steg 3: Hva er vanskeligst -->
    <section class="card ob-step ob-hidden" id="ob-step-3">
      <p class="eyebrow">Steg 3 av 3</p>
      <h1>Hva synes du er vanskeligst?</h1>
      <p class="muted">Sightline gir deg én konkret forbedring per bilde, alltid tilpasset dette.</p>

      <div class="ob-choice-group">
        <label class="ob-choice">
          <input type="radio" name="biggest_challenge" value="Bildene blir mørke eller uklare" />
          <span>
            <strong>Bildene blir mørke eller uklare</strong>
            <small>Eksponeringen er av, eller bildet er ikke skarpt</small>
          </span>
        </label>
        <label class="ob-choice">
          <input type="radio" name="biggest_challenge" value="Jeg vet ikke hva jeg skal fotografere" />
          <span>
            <strong>Jeg vet ikke hva jeg skal fotografere</strong>
            <small>Mangler ideer eller ser ikke motivene</small>
          </span>
        </label>
        <label class="ob-choice">
          <input type="radio" name="biggest_challenge" value="Bildene ser kjedelige ut" />
          <span>
            <strong>Bildene ser kjedelige ut</strong>
            <small>Teknisk OK, men mangler liv eller stemning</small>
          </span>
        </label>
        <label class="ob-choice">
          <input type="radio" name="biggest_challenge" value="Vet ikke ennå" />
          <span>
            <strong>Vet ikke ennå</strong>
            <small>Bare nysgjerrig og vil prøve</small>
          </span>
        </label>
      </div>

      <div class="ob-nav-row" style="margin-top:20px">
        <button type="button" class="button secondary" id="ob-back-3">← Tilbake</button>
        <button type="submit" class="button primary">Lag profil</button>
      </div>
    </section>

  </form>
</main>

<script>
(function () {
  function showStep(n) {
    document.querySelectorAll('.ob-step').forEach(function (s) {
      s.classList.add('ob-hidden');
    });
    document.getElementById('ob-step-' + n).classList.remove('ob-hidden');
    document.querySelectorAll('.ob-dot').forEach(function (d) {
      d.classList.toggle('active', Number(d.dataset.step) <= n);
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.getElementById('ob-next-1').addEventListener('click', function () {
    var name = document.querySelector('[name="name"]').value.trim();
    var exp = document.querySelector('[name="experience_level"]:checked');
    if (!name) { alert('Skriv inn navnet ditt.'); return; }
    if (!exp) { alert('Velg erfaringsnivå.'); return; }
    showStep(2);
  });

  document.getElementById('ob-next-2').addEventListener('click', function () {
    var style = document.querySelector('[name="preferred_style"]:checked');
    if (!style) { alert('Velg en stil.'); return; }
    showStep(3);
  });

  document.getElementById('ob-back-2').addEventListener('click', function () { showStep(1); });
  document.getElementById('ob-back-3').addEventListener('click', function () { showStep(2); });
})();
</script>

<%- include('partials/footer') %>
