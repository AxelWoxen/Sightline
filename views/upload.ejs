<%- include('partials/header') %>
<%- include('partials/navbar') %>
<main class="page narrow">
  <section class="card">
    <p class="eyebrow">Upload</p>
    <h1>Submit a photo for critique</h1>
    <p class="muted">Choose a challenge, upload one image, and get structured local MVP feedback. Later, this same flow can be connected to real AI.</p>

    <% if (error) { %>
      <div class="error-message">
        <%= error %>
      </div>
    <% } %>

    <% if (!challenges || challenges.length === 0) { %>
      <p class="muted">No challenges are available yet. Add challenges to the database before uploading.</p>
      <a class="button secondary" href="/dashboard">Back to dashboard</a>
    <% } else { %>
      <form class="form" action="/photos/upload" method="POST" enctype="multipart/form-data">
        <label>Choose challenge
          <select name="challenge_id" required>
            <% challenges.forEach(challenge => { %>
              <option
                value="<%= challenge.id %>"
                <%= String(challenge.id) === String(selectedChallengeId) ? 'selected' : '' %>
              >
                <%= challenge.title %> <% if (challenge.focus_area) { %>— <%= challenge.focus_area %><% } %>
              </option>
            <% }) %>
          </select>
        </label>

        <label>Photo
          <input type="file" class ="button danger" name="photo" accept="image/*" required />
        </label>

        <label>What were you trying to capture?
          <textarea name="caption" rows="4" placeholder="Mood, light, subject, story..."></textarea>
        </label>

        <button class="button primary" type="submit">Upload and get critique</button>
      </form>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
