<%- include('partials/header') %>
<%- include('partials/navbar') %>
<main class="page narrow">
  <section class="card">
    <p class="eyebrow">Last opp</p>
    <h1>Send inn et bilde for tilbakemelding</h1>
    <p class="muted">Velg en utfordring, last opp ett bilde, og få AI-feedback innen 15 sekunder.</p>

    <% if (error) { %>
      <div class="error-message">
        <%= error %>
      </div>
    <% } %>

    <% if (!challenges || challenges.length === 0) { %>
      <p class="muted">Ingen utfordringer er tilgjengelig ennå. Legg til utfordringer i databasen.</p>
      <a class="button secondary" href="/dashboard">Tilbake til dashboard</a>
    <% } else { %>
      <form class="form" id="upload-form" action="/photos/upload" method="POST" enctype="multipart/form-data">
        <label>Velg utfordring
          <select name="challenge_id" required>
            <% challenges.forEach(challenge => { %>
              <option
                value="<%= challenge.id %>"
                <%= String(challenge.id) === String(selectedChallengeId) ? 'selected' : '' %>
              >
                <%= challenge.title %> <% if (challenge.focus_area) { %>— <%= challenge.focus_area %><% } %>
              </option>
            <% }) %>
          </select>
        </label>

        <label>Bilde
          <input type="file" name="photo" accept="image/*" required />
        </label>

        <label>Hva prøvde du å fange?
          <textarea name="caption" rows="4" placeholder="Stemning, lys, motiv, historie..."></textarea>
        </label>

        <button class="button primary" id="upload-btn" type="submit">Last opp og få tilbakemelding</button>
      </form>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
