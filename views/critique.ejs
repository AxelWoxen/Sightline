<%- include('partials/header') %>
<%- include('partials/navbar') %>
<main class="page">

  <section class="critique-hero">
    <p class="eyebrow">AI-tilbakemelding</p>
    <h1><%= photo.caption || 'Ditt bilde' %></h1>
    <% if (photo.challenge_title) { %>
      <p class="muted">Utfordring: <strong style="color:var(--text)"><%= photo.challenge_title %></strong></p>
    <% } %>
    <% if (photo.challenge_focus_area) { %>
      <div class="tag-row">
        <span class="tag"><%= photo.challenge_focus_area %></span>
        <% if (photo.challenge_category) { %>
          <span class="tag"><%= photo.challenge_category %></span>
        <% } %>
      </div>
    <% } %>
  </section>

  <div class="critique-photo-wrap">
    <img class="critique-photo" src="/<%= photo.image_path.replace(/^\//, '') %>" alt="Opplastet bilde" />
  </div>

  <% if (critique) { %>

  <section class="critique-scores card">
    <h2>Scorer</h2>
    <div class="score-bars">

      <div class="score-bar-row">
        <span class="score-label">Komposisjon</span>
        <div class="score-track">
          <div class="score-fill" style="width:<%= critique.composition_score %>%"></div>
        </div>
        <span class="score-num"><%= critique.composition_score %></span>
      </div>

      <div class="score-bar-row">
        <span class="score-label">Lys</span>
        <div class="score-track">
          <div class="score-fill" style="width:<%= critique.lighting_score %>%"></div>
        </div>
        <span class="score-num"><%= critique.lighting_score %></span>
      </div>

      <div class="score-bar-row">
        <span class="score-label">Historiefortelling</span>
        <div class="score-track">
          <div class="score-fill" style="width:<%= critique.storytelling_score %>%"></div>
        </div>
        <span class="score-num"><%= critique.storytelling_score %></span>
      </div>

      <div class="score-bar-row">
        <span class="score-label">Teknisk</span>
        <div class="score-track">
          <div class="score-fill" style="width:<%= critique.technical_score %>%"></div>
        </div>
        <span class="score-num"><%= critique.technical_score %></span>
      </div>

    </div>
  </section>

  <section class="critique-feedback">
    <% const feedbackSections = [
      { label: 'Hva fungerer',           text: critique.feedback_what_works },
      { label: 'Hva som skjedde teknisk', text: critique.feedback_technical },
      { label: 'Hva du kan gjøre',        text: critique.feedback_camera },
      { label: 'Prøv dette neste gang',   text: critique.feedback_next_time }
    ] %>

    <% const hasStructured = feedbackSections.some(s => s.text); %>

    <% if (hasStructured) { %>
      <% feedbackSections.forEach(s => { %>
        <% if (s.text) { %>
        <div class="feedback-section">
          <p class="eyebrow"><%= s.label %></p>
          <p><%= s.text %></p>
        </div>
        <% } %>
      <% }) %>
    <% } else { %>
      <div class="feedback-section">
        <p class="feedback-text"><%= critique.feedback_text %></p>
      </div>
    <% } %>
  </section>

  <section class="critique-cta card highlight">
    <div class="critique-cta-inner">
      <p class="eyebrow">Neste steg</p>
      <h2><%= critique.next_task %></h2>
      <a
        class="button primary critique-cta-btn"
        href="/photos/upload<%= photo.challenge_id ? '?challenge=' + photo.challenge_id : '' %>"
      >Last opp neste bilde med denne utfordringen</a>
    </div>
  </section>

  <% if (typeof suggestedChallenge !== 'undefined' && suggestedChallenge) { %>
  <section class="suggested-challenge card">
    <p class="eyebrow">Din neste utfordring</p>
    <h2><%= suggestedChallenge.title %></h2>
    <p><%= suggestedChallenge.description %></p>
    <% if (suggestedChallenge.why_this_challenge) { %>
      <p class="why-this"><%= suggestedChallenge.why_this_challenge %></p>
    <% } %>
    <div class="tag-row">
      <span class="tag"><%= suggestedChallenge.focus_area %></span>
      <% if (suggestedChallenge.difficulty) { %><span class="tag"><%= suggestedChallenge.difficulty %></span><% } %>
    </div>
    <a
      class="button primary"
      href="/photos/upload<%= suggestedChallenge.linked_challenge_id ? '?challenge=' + suggestedChallenge.linked_challenge_id : '' %>"
    >Ta denne utfordringen</a>
  </section>
  <% } %>

  <% } else { %>
  <section class="card">
    <p class="muted">Ingen tilbakemelding er tilgjengelig for dette bildet ennå.</p>
    <p>Dette kan skje hvis en tidligere opplasting ble avbrutt. Bildet er fortsatt lagret.</p>
  </section>
  <% } %>

  <div class="critique-secondary-links">
    <a class="button secondary" href="/progress">Se fremgang</a>
    <a class="button secondary" href="/dashboard">Dashboard</a>
  </div>

</main>
<%- include('partials/footer') %>
