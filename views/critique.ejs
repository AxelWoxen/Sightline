<%- include('partials/header') %>
<%- include('partials/navbar') %>
<main class="page">
  <section class="dashboard-header">
    <div>
      <p class="eyebrow">AI critique</p>
      <h1>Your photo feedback</h1>
      <% if (photo.challenge_title) { %>
        <p class="muted">Challenge: <%= photo.challenge_title %></p>
      <% } %>
    </div>
    <a class="button secondary" href="/photos/upload">Upload another</a>
  </section>

  <section class="grid two">
    <article class="card">
      <img class="photo-large" src="<%= photo.image_path %>" alt="Uploaded photo" />
      <% if (photo.caption) { %>
        <p class="muted">Your intention: <%= photo.caption %></p>
      <% } %>
      <% if (photo.challenge_focus_area) { %>
        <div class="tag-row">
          <span class="tag"><%= photo.challenge_focus_area %></span>
          <% if (photo.challenge_category) { %>
            <span class="tag"><%= photo.challenge_category %></span>
          <% } %>
        </div>
      <% } %>
    </article>

    <article class="card">
      <h2>Structured feedback</h2>

      <% if (critique) { %>
        <div class="score-list">
          <div><span>Composition</span><strong><%= critique.composition_score %></strong></div>
          <div><span>Lighting</span><strong><%= critique.lighting_score %></strong></div>
          <div><span>Storytelling</span><strong><%= critique.storytelling_score %></strong></div>
          <div><span>Technical</span><strong><%= critique.technical_score %></strong></div>
        </div>
        <p class="feedback-text"><%= critique.feedback_text %></p>
        <div class="next-task">
          <p class="eyebrow">Next task</p>
          <p><%= critique.next_task %></p>
        </div>
      <% } else { %>
        <p class="muted">No critique is available for this photo yet.</p>
        <p>This can happen if a previous upload was interrupted. The photo is still saved, and the critique flow can be regenerated later when the AI service is connected.</p>
      <% } %>
    </article>
  </section>
</main>
<%- include('partials/footer') %>
