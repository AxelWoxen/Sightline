<%- include('partials/header') %>
<%- include('partials/navbar') %>
<main class="page">

  <section class="dashboard-header">
    <div>
      <p class="eyebrow">Velkommen tilbake</p>
      <h1>Hei, <%= currentUser ? currentUser.name : 'fotograf' %></h1>
      <p class="muted">Du fotograferer <%= currentUser ? currentUser.preferred_style : '' %>.</p>
    </div>
    <a class="button primary" href="/photos/upload">Last opp bilde</a>
  </section>

  <!-- Generated challenges -->
  <section class="section-block">
    <div class="section-title-row">
      <h2>Dine utfordringer i dag</h2>
    </div>

    <% if (generatedChallenges && generatedChallenges.length > 0) { %>
      <div class="grid three">
        <% generatedChallenges.forEach(function(c) { %>
        <article class="card challenge-card">
          <div class="tag-row" style="margin:0 0 12px">
            <span class="tag"><%= c.focus_area %></span>
            <% if (c.difficulty) { %><span class="tag"><%= c.difficulty %></span><% } %>
          </div>
          <h3 style="margin:0 0 8px;font-size:1.1rem;letter-spacing:-0.01em"><%= c.title %></h3>
          <p class="muted" style="font-size:0.9rem;margin:0 0 10px"><%= c.description %></p>
          <% if (c.why_this_challenge) { %>
            <p class="why-this"><%= c.why_this_challenge %></p>
          <% } %>
          <a
            class="button secondary"
            href="/photos/upload<%= c.linked_challenge_id ? '?challenge=' + c.linked_challenge_id : '' %>"
            style="margin-top:auto"
          >Prøv denne</a>
        </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card">
        <p class="muted">Utfordringer genereres første gang du bruker appen.</p>
        <a class="button secondary" href="/photos/upload">Last opp ditt første bilde</a>
      </div>
    <% } %>
  </section>

  <!-- Latest photo / empty state -->
  <section class="section-block">
    <% if (latest && latest.feedback_text) { %>
      <div class="section-title-row">
        <h2>Siste tilbakemelding</h2>
        <a href="/progress" class="muted" style="font-size:0.9rem">Se alle →</a>
      </div>
      <article class="card" style="display:grid;grid-template-columns:200px 1fr;gap:22px;align-items:start">
        <img
          src="/<%= latest.image_path.replace(/^\//, '') %>"
          alt="Siste bilde"
          style="width:100%;height:150px;object-fit:cover;border-radius:16px"
        />
        <div>
          <% if (latest.challenge_title) { %>
            <p class="eyebrow" style="margin-bottom:6px"><%= latest.challenge_title %></p>
          <% } %>
          <% var avg = Math.round(((latest.composition_score||0)+(latest.lighting_score||0)+(latest.storytelling_score||0)+(latest.technical_score||0))/4); %>
          <div class="dash-score-row">
            <span class="muted" style="font-size:0.82rem;white-space:nowrap">Snittskår</span>
            <div class="score-track" style="flex:1"><div class="score-fill" style="width:<%= avg %>%"></div></div>
            <strong style="color:var(--accent)"><%= avg %></strong>
          </div>
          <% if (latest.challenge_focus_area) { %>
            <p class="muted" style="font-size:0.85rem;margin:10px 0 0">
              Fokus: <strong style="color:var(--text)"><%= latest.challenge_focus_area %></strong>
            </p>
          <% } %>
          <a class="button secondary" href="/critique/<%= latest.id %>">Se full feedback</a>
        </div>
      </article>
    <% } else if (!latest) { %>
      <article class="card" style="text-align:center;padding:48px 28px">
        <h2 style="margin:0 0 12px">Last opp ditt første bilde</h2>
        <p class="muted" style="max-width:460px;margin:0 auto 24px">
          Last opp ett bilde og finn ut hva kameraet ditt egentlig ser.
          Du får én konkret forbedring — ikke en liste med alt som er feil.
        </p>
        <a class="button primary" href="/photos/upload">Last opp bilde</a>
      </article>
    <% } %>
  </section>

</main>
<%- include('partials/footer') %>
